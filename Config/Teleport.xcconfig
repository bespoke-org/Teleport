// Build settings shared by both targets. Values that differ per developer live
// in Local.xcconfig, which git ignores; start from Local.xcconfig.example.
#include? "Local.xcconfig"

// Release builds are universal (arm64 + x86_64); Debug builds only the host
// architecture to stay fast.
ARCHS = $(ARCHS_STANDARD)
ONLY_ACTIVE_ARCH[config=Debug] = YES
ONLY_ACTIVE_ARCH[config=Release] = NO
